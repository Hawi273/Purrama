{
  "name": "purrama",
  "version": "2.0.0",
  "private": true,
  "description": "Cozy movie and TV discovery for night owls. Static site (GitHub Pages) + Cloudflare Worker proxy for TMDB.",
  "type": "module",
  "scripts": {
    "dev:api": "wrangler dev --cwd worker --env dev --port 8787",
    "dev:site": "node scripts/serve.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --test test/",
    "release": "node scripts/release.mjs",
    "check": "npm run typecheck && npm run lint && npm test && node scripts/release.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "wrangler": "4.163.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261116.1": true
  }
}
